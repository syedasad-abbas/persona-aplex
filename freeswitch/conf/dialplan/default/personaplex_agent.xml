<include>
  <!--
    PersonaPlex Voice Agent Extension

    Routes inbound calls to the PersonaPlex AI agent.
    The v2-cpu bridge connects via ESL inbound and uses uuid_audio_stream
    to pipe call audio to PersonaPlex's speech-to-speech model.

    The call is answered and parked; the bridge detects CHANNEL_ANSWER
    via ESL events and starts the audio stream automatically.

    To route calls here, set destination_number to "persona_agent"
    or adjust the regex below to match your DID/extension.
  -->
  <extension name="personaplex_agent">
    <condition field="destination_number" expression="^persona_agent$">
      <condition field="${personaplex_agent_allowed}" expression="^true$">
        <action application="set" data="personaplex_agent=true"/>
        <action application="answer"/>
        <action application="set" data="record_stereo=true"/>
        <action application="record_session" data="/tmp/personaplex_agent_${uuid}.wav"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="playback_terminators=none"/>
        <!-- Keep a silent outbound media clock; mod_audio_stream replaces it with Moshi audio. -->
        <action application="playback" data="silence_stream://-1"/>
      </condition>
    </condition>
  </extension>
</include>

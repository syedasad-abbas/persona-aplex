<include>
  <extension name="personaplex_agent_public_alias">
    <condition field="destination_number" expression="^(persona_agent|9000)$">
      <action application="set" data="personaplex_agent_allowed=true"/>
      <action application="transfer" data="persona_agent XML default"/>
    </condition>
  </extension>

  <extension name="personaplex_inbound_did">
    <condition field="destination_number" expression="^(\+?16308690325|6308690325|\+?442037692810|00441277679024|01277679024)$">
      <action application="set" data="personaplex_agent_allowed=true"/>
      <action application="transfer" data="persona_agent XML default"/>
    </condition>
  </extension>
</include>

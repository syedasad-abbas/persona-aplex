services:
  personaplex-fs:
    build:
      context: .
      dockerfile: v2-cpu/Dockerfilegpu-allinone

    #gpus: all

    environment:
      - HF_TOKEN=${HF_TOKEN}

      # FreeSWITCH ESL
      - FS_ESL_HOST=127.0.0.1
      - FS_ESL_PORT=8021
      - FS_ESL_PASSWORD=FS!Secure2026

      # FreeSWITCH SIP
      - FS_PUBLIC_IP=${FS_PUBLIC_IP:-192.169.46.42}
      - FS_PUBLIC_IP_URL=${FS_PUBLIC_IP_URL:-https://api.ipify.org}
      - FS_SIP_DOMAIN=${FS_SIP_DOMAIN:-192.169.46.42}

      # External MySQL
      - DB_HOST=${DB_HOST}
      - DB_PORT=${DB_PORT:-3306}
      - DB_USER=${DB_USER}
      - DB_PASS=${DB_PASS}
      - DB_NAME=${DB_NAME:-agent_db}

      # Moshi
      - MOSHI_DEVICE=cpu

      - MOSHI_CPU_THREADS=${MOSHI_CPU_THREADS:-16}
      - MOSHI_CPU_INTEROP_THREADS=${MOSHI_CPU_INTEROP_THREADS:-1}
      - OMP_NUM_THREADS=${MOSHI_CPU_THREADS:-16}
      - MKL_NUM_THREADS=${MOSHI_CPU_THREADS:-16}
      - OPENBLAS_NUM_THREADS=1
      - NUMEXPR_NUM_THREADS=1

      # PersonaPlex
      - LOG_LEVEL=${LOG_LEVEL:-INFO}
      - VOICE_PROMPT=NATF2.pt
      - AGENT_DOMAIN=appointment

      # Relay now points to localhost
      - RELAY_HOST=127.0.0.1

      - FORK_MEDIA_MODE=mono
      - FORK_RETRY_ON_NO_FRAMES=0

      - INBOUND_GAIN=4.0
      - OUTBOUND_GAIN=4.0
      - OUTBOUND_LIMIT_PEAK=0.85

      - FS_SAMPLE_RATE=16000
      - FS_PLAYBACK_SAMPLE_RATE=8000

      - MOSHI_HANDSHAKE_TIMEOUT=1800
      - MOSHI_PREWARM=1
      - MOSHI_PREWARM_TIMEOUT=1800
      - MOSHI_BUSY_WAIT_TIMEOUT=120
      - MOSHI_PREWARM_MAX_AGE=3600

      - MOSHI_SKIP_SYSTEM_PROMPTS=0
      - MOSHI_SKIP_VOICE_PROMPT_STEPS=1
      - MOSHI_AUDIO_SILENCE_FRAME_CNT=6
      - MOSHI_SKIP_SYSTEM_PROMPTS_KEEP_SILENCE=0

      - EXPECTED_AI_PHRASE=HealthFirst

      - VERIFIED_AI_RESPONSE_ENABLED=0
      - VERIFIED_AI_RESPONSE_MODE=assist
      - VERIFIED_AI_RESPONSE_TEXT=Hello, this is Alex from HealthFirst Medical Center. May I have your full name?
      - VERIFIED_AI_RESPONSE_VOICE=slt
      - VERIFIED_AI_RESPONSE_TRIGGER_ACTIVE_MS=0
      - VERIFIED_AI_RESPONSE_TRIGGER_PEAK=0
      - VERIFIED_AI_RESPONSE_SUPPRESS_MOSHI_AFTER=0

      - AUDIBLE_ACTIVE_THRESHOLD=500
      - AUDIBLE_MIN_ACTIVE_MS=150

      - RELAY_READY_TIMEOUT=120
      - REQUIRE_MOSHI_PREWARM_READY=1
      - MOSHI_INITIAL_PREWARM_READY_TIMEOUT=1800

      - AUDIO_STATS_INTERVAL=5

      - OUTBOUND_TEST_TONE=0
      - OUTBOUND_TEST_TONE_DELAY=5.0
      - OUTBOUND_TEST_TONE_DURATION_MS=2500
      - OUTBOUND_TEST_TONE_CALLER=0000000000

      - FS_PLAYBACK_BROADCAST_FALLBACK=0
      - FS_PLAYBACK_BROADCAST_BATCH_MS=480
      - FS_PLAYBACK_BROADCAST_MAX_DELAY_MS=8000
      - FS_PLAYBACK_BROADCAST_DELAY=0.10

    ports:
      - "5060:5060/udp"
      - "5060:5060/tcp"
      - "5090:5060/udp"
      - "5090:5060/tcp"
      - "5080:5080/udp"
      - "8021:8021/tcp"
      - "4000-4100:4000-4100/udp"

    ulimits:
      nofile:
        soft: 65536
        hard: 65536

    volumes:
      - model_cache:/app/cache

    restart: unless-stopped

volumes:
  model_cache:
